# ============================================================
# Arena SaaS — Environment Variables (copy to .env on server)
# ============================================================
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
REDIS_URL=redis://127.0.0.1:6379

# Auth / Security
SESSION_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_APP_URL=https://app.example.de

# Stripe (Billing + Connect + Terminal)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Fiskaly Cloud-TSE (KassenSichV)
FISKALY_API_KEY=
FISKALY_CLIENT_ID=
FISKALY_TSE_SERIAL=

# Email (SMTP / Resend)
RESEND_API_KEY=
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.de

# SMS / WhatsApp (optional, e.g. Twilio / Meta WhatsApp API)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_API_TOKEN=

# AI Advisor (Claude API)
ANTHROPIC_API_KEY=

# Cron / Jobs (BullMQ + Redis) — reminders, monthly invoices, accountant dispatch
CRON_SECRET=change-me
# netcup Ubuntu 24.04 + CloudPanel cron examples:
# 0 * * * *  curl -s -H "Authorization: Bearer $CRON_SECRET" https://app.example.de/api/cron/reminders
# 0 2 1 * *  curl -s -H "Authorization: Bearer $CRON_SECRET" https://app.example.de/api/cron/monthly
# 0 3 * * *  pg_dump $DATABASE_URL | gzip > /backups/app_db-$(date +\%F).sql.gz

# Platform defaults (Root can override per tenant/project)
PLATFORM_COMMISSION_PERCENT_BP=500
PLATFORM_COMMISSION_FIXED_CENTS=30
PLATFORM_TAX_RATE_BP=1900
GRACE_DAYS=7

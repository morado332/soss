# ============================================================
# Arena SaaS — Environment Variables (copy to .env)
# ============================================================
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public URL. If it starts with https:// → Secure cookies, HSTS and upgrade-insecure-requests are enabled.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Force cookie "Secure" flag on/off (default: derived from NEXT_PUBLIC_APP_URL)
# COOKIE_SECURE=true

# First-run setup: optional fixed token for /setup. If empty, a random one-time token
# is generated at server start and printed to the server log.
SETUP_TOKEN=

# Set to "true" to skip automatic DB migrations on startup
# SKIP_DB_MIGRATIONS=false

# ---- Integrations (not yet wired — integration points in code) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FISKALY_API_KEY=
FISKALY_CLIENT_ID=
ANTHROPIC_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.de
